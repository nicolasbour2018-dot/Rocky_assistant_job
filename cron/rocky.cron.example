# Synchronisation Gmail puis veille Rocky chaque jour à midi, heure locale du Mac.
# Remplace le chemin avant de copier ces deux lignes dans crontab -e.
ROCKY_DIR=/absolute/path/to/rocky
0 12 * * * cd "$ROCKY_DIR" && "$ROCKY_DIR/.venv/bin/python" scripts/run_daily.py >> "$ROCKY_DIR/logs/cron.log" 2>&1
