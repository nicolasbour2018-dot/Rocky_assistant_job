# PostgreSQL
# Sur Hugging Face, Rocky utilise plutôt DATABASE_URL=sqlite:////data/rocky.db
DATABASE_URL=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rocky

# Agent Rocky - Mistral AI
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# API France Travail
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# API Adzuna
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=fr

# Collecte Indeed et enrichissement volontaire des descriptions incomplètes
THEIRSTACK_API_KEY=
THEIRSTACK_INDEED_MAX_AGE_DAYS=30

# Veille
MATCH_THRESHOLD=70
WATCH_RESULTS_PER_QUERY=20

# Déploiement Hugging Face (uniquement dans le .env local)
HF_TOKEN=
HF_REPO=Neomac21/rocky-job-assistant
