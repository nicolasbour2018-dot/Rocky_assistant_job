# PostgreSQL
# Sur Hugging Face, Rocky utilise plutôt DATABASE_URL=sqlite:////data/rocky.db
DATABASE_URL=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rocky

# Comptes Rocky et liens envoyés par e-mail
ROCKY_PUBLIC_URL=http://localhost:8501
# Secret long et aléatoire, propre à l'instance (prévu pour la protection de session).
ROCKY_SESSION_SECRET=

# SMTP — requis pour vérifier les adresses et réinitialiser les mots de passe.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Agent Rocky - Mistral AI
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# API France Travail
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# API Adzuna
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=fr

# Collecte Indeed et enrichissement volontaire des descriptions incomplètes
THEIRSTACK_API_KEY=
THEIRSTACK_INDEED_MAX_AGE_DAYS=30

# Veille
MATCH_THRESHOLD=70
WATCH_RESULTS_PER_QUERY=20

# Gmail API officielle — OAuth local en lecture seule.
# Le client Desktop app est placé dans .secrets/gmail/credentials.json ;
# chaque jeton reste dans data/users/<user_id>/gmail/accounts/.
GMAIL_MAX_MESSAGES=100
GMAIL_LOOKBACK_DAYS=180
# Adresses réelles uniquement dans .env, séparées par des virgules.
GMAIL_ACCOUNTS=
# Callback local reçu par Streamlit après le consentement OAuth.
GMAIL_OAUTH_REDIRECT_URI=http://localhost:8501/
