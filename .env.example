# Nouveau Rocky — variables lues par docker-compose.yml (interpolation).
# Copier ce fichier en .env et remplir les valeurs. Le .env n'est jamais versionné.
# Chaque étape de la refonte ajoute ici les variables dont elle a besoin.

# PostgreSQL de développement (service db).
# Lettres et chiffres uniquement : le mot de passe applicatif entre dans une URL
# de connexion. Exemple : openssl rand -hex 24
# Administrateur, réservé à l'initialisation de la base.
ROCKY_DB_ADMIN_PASSWORD=
# Rôle applicatif rocky_app (sans privilège de superutilisateur).
ROCKY_DB_APP_PASSWORD=

# Adresse publique de Rocky : base des liens envoyés par e-mail.
# En https, le cookie de session devient Secure. Valeur par défaut en local :
ROCKY_PUBLIC_URL=http://127.0.0.1:8000

# SMTP des e-mails de compte (invitation, mot de passe oublié).
# Facultatif : sans SMTP, Rocky démarre, mais invitation et oubli échouent avec
# un message explicite (rocky-admin invite --print-link reste possible).
# Gmail : smtp.gmail.com, port 587, STARTTLS, et un mot de passe d'application
# (https://myaccount.google.com/apppasswords), jamais le mot de passe du compte.
# Port 465 : TLS direct (STARTTLS ignoré).
ROCKY_SMTP_HOST=
ROCKY_SMTP_PORT=587
ROCKY_SMTP_USERNAME=
ROCKY_SMTP_PASSWORD=
# Expéditeur affiché, par exemple : Rocky <adresse@exemple.fr>
ROCKY_SMTP_FROM=
ROCKY_SMTP_STARTTLS=true
