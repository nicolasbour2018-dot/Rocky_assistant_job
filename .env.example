# Nouveau Rocky — variables lues par docker-compose.yml (interpolation).
# Copier ce fichier en .env et remplir les valeurs. Le .env n'est jamais versionné.
# Chaque étape de la refonte ajoute ici les variables dont elle a besoin.

# PostgreSQL de développement (service db).
# Lettres et chiffres uniquement : le mot de passe applicatif entre dans une URL
# de connexion. Exemple : openssl rand -hex 24
# Administrateur, réservé à l'initialisation de la base.
ROCKY_DB_ADMIN_PASSWORD=
# Rôle applicatif rocky_app (sans privilège de superutilisateur).
ROCKY_DB_APP_PASSWORD=

# Adresse publique de Rocky : base des liens envoyés par e-mail.
# En https, le cookie de session devient Secure. Valeur par défaut en local :
ROCKY_PUBLIC_URL=http://127.0.0.1:8000

# SMTP des e-mails de compte (invitation, mot de passe oublié).
# Facultatif : sans SMTP, Rocky démarre, mais invitation et oubli échouent avec
# un message explicite (rocky-admin invite --print-link reste possible).
# Gmail : smtp.gmail.com, port 587, STARTTLS, et un mot de passe d'application
# (https://myaccount.google.com/apppasswords), jamais le mot de passe du compte.
# Port 465 : TLS direct (STARTTLS ignoré).
ROCKY_SMTP_HOST=
ROCKY_SMTP_PORT=587
ROCKY_SMTP_USERNAME=
ROCKY_SMTP_PASSWORD=
# Expéditeur affiché, par exemple : Rocky <adresse@exemple.fr>
ROCKY_SMTP_FROM=
ROCKY_SMTP_STARTTLS=true

# Sources d'offres (étape C1, docs/decisions/C1-sources.md). Toutes facultatives :
# une source sans ses clés est affichée « non configurée », les autres fonctionnent.
# Adzuna : clés de l'API officielle (https://developer.adzuna.com/).
ROCKY_ADZUNA_APP_ID=
ROCKY_ADZUNA_APP_KEY=
# France Travail : « en attente d'accès » (D8) tant que ENABLED n'est pas true.
# Identifiants de l'application abonnée à l'API Offres d'emploi v2, pas ceux d'un compte personnel.
ROCKY_FRANCE_TRAVAIL_ENABLED=false
ROCKY_FRANCE_TRAVAIL_CLIENT_ID=
ROCKY_FRANCE_TRAVAIL_CLIENT_SECRET=
# Résultats demandés par requête (une seule page).
ROCKY_SOURCES_RESULTS_PER_QUERY=20

# Modèles de langage (étapes C3 et G4, docs/decisions/G4-assistant.md) : jamais un fait ni le score. Facultatifs :
# sans la clé de son fournisseur, un appel est « indisponible » avec sa raison.
# Fournisseurs : gemini, anthropic, openai, mistral. Le modèle par défaut sert à tous les appels…
ROCKY_MODEL_PROVIDER=gemini
ROCKY_MODEL_NAME=gemini-3.5-flash-lite
# … sauf ceux d'un type qui a le sien : fournisseur ET modèle, ensemble. Types : ASSISTANT, SUMMARY (résumé d'offre),
# CV (import), TRANSLATION, LETTER, RECRUITER_MESSAGE, MAIL_CLASSIFICATION. Exemple :
# ROCKY_ASSISTANT_MODEL_PROVIDER=anthropic
# ROCKY_ASSISTANT_MODEL_NAME=claude-sonnet-5-5
# Une clé par fournisseur utilisé (Gemini : https://aistudio.google.com/).
ROCKY_GEMINI_API_KEY=
ROCKY_ANTHROPIC_API_KEY=
ROCKY_OPENAI_API_KEY=
ROCKY_MISTRAL_API_KEY=
# Questions à l'assistant 🐾 par compte et par jour (heure de Paris).
ROCKY_ASSISTANT_DAY_LIMIT=5
# Classement des messages (étape E2, docs/decisions/E2-classification.md) : le modèle ne lit que les messages que les
# règles ne tranchent pas et qui portent un signal de recherche d'emploi. Plafonds d'appels par compte.
ROCKY_LLM_MAIL_HOUR_LIMIT=20
ROCKY_LLM_MAIL_DAY_LIMIT=60

# Planificateur (étape C6, docs/decisions/C6-veille.md) : veille chaque jour à 12 h (heure de Paris), recalcul des
# scores après un changement du profil, purge des sessions expirées. « false » l'éteint (la veille reste lançable
# depuis l'écran ou par `rocky-admin veille`).
ROCKY_SCHEDULER_ENABLED=true

# Gmail en lecture seule (étape E1, docs/decisions/E1-collecte.md, procédure docs/procedures/e1-gmail/).
# Facultatif : sans ces trois valeurs, 📬 Messages affiche « Gmail n'est pas configuré ».
# Client OAuth Google de type « Application Web », URI de redirection : <ROCKY_PUBLIC_URL>/messages/gmail/retour.
ROCKY_GOOGLE_CLIENT_ID=
ROCKY_GOOGLE_CLIENT_SECRET=
# Clé qui chiffre en base les jetons des boîtes Gmail (Fernet). La changer oblige à reconnecter les boîtes.
# Exemple : uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ROCKY_SECRET_KEY=
